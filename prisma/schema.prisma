// ============================================================================
// Prisma Schema - TrainX Payment Module
// ============================================================================
// This schema defines the database models for the payment integration system.
// It uses PostgreSQL via Supabase with separate pooled and direct connections.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection via PgBouncer for runtime queries
  url       = env("DATABASE_URL")
  // Direct connection for migrations (bypasses PgBouncer)
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Payment - Core payment record linked to an ERP fee
// ============================================================================
// Represents a single logical payment intent for a student's fee.
// Multiple PaymentAttempts can be made against one Payment.
model Payment {
  id              String          @id @default(uuid()) @db.Uuid
  // Unique internal order identifier (e.g., "TXN-xxxxxxxx") 
  orderId         String          @unique @map("order_id")
  // Reference to the ERP fee being paid
  feeReference    String          @map("fee_reference")
  // Student who owns this payment
  studentId       String          @map("student_id")
  // Monetary amount using Decimal for exact financial calculations - NEVER float
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("INR") @db.VarChar(3)
  // Current payment lifecycle status
  status          PaymentStatus   @default(CREATED)
  // Cashfree order ID returned after order creation
  cashfreeOrderId String?         @map("cashfree_order_id")
  // Client-provided idempotency key to prevent duplicate payments
  idempotencyKey  String          @unique @map("idempotency_key")
  // Human-readable description of the fee/payment
  description     String?
  // Fee settlement tracking
  feeSettled      Boolean         @default(false) @map("fee_settled")
  // Failure tracking
  failureReason   String?         @map("failure_reason")
  // Timestamps
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  paidAt          DateTime?       @map("paid_at")

  // Relations
  attempts        PaymentAttempt[]
  webhookEvents   WebhookEvent[]

  // Indexes for common query patterns
  @@index([studentId])
  @@index([feeReference])
  @@index([status])
  @@index([cashfreeOrderId])
  @@index([createdAt])
  @@map("payments")
}

// ============================================================================
// PaymentAttempt - Individual payment attempt against a Payment
// ============================================================================
// Tracks each discrete payment attempt (e.g., UPI, card, netbanking).
// A single Payment can have multiple attempts (e.g., first attempt fails, user retries).
model PaymentAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  // Parent payment
  paymentId         String              @map("payment_id") @db.Uuid
  payment           Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Cashfree's unique payment identifier for this attempt
  cashfreePaymentId String?             @map("cashfree_payment_id")
  // Sequential attempt number within the parent payment
  attemptNumber     Int                 @map("attempt_number")
  // Status of this specific attempt (separate from overall Payment status)
  status            PaymentAttemptStatus @default(PENDING)
  // Payment method used (e.g., "upi", "card", "netbanking") - no sensitive details
  paymentMethod     String?             @map("payment_method")
  // Failure details (sanitized - never raw gateway error dumps)
  failureCode       String?             @map("failure_code")
  failureMessage    String?             @map("failure_message")
  // Timestamps
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([paymentId, attemptNumber])
  @@index([cashfreePaymentId])
  @@index([status])
  @@map("payment_attempts")
}

// ============================================================================
// WebhookEvent - Record of received Cashfree webhook events
// ============================================================================
// Every webhook received is recorded for audit, deduplication, and debugging.
// The eventKey provides deduplication via a unique DB constraint.
model WebhookEvent {
  id                String              @id @default(uuid()) @db.Uuid
  // Deduplication key: composite of event type + order ID + payment ID (if present)
  // Ensures the same event is not processed twice
  eventKey          String              @unique @map("event_key")
  // Type of webhook event (e.g., PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK)
  eventType         String              @map("event_type")
  // Associated Cashfree identifiers
  cashfreeOrderId   String              @map("cashfree_order_id")
  cashfreePaymentId String?             @map("cashfree_payment_id")
  // Reference to internal payment (nullable if order ID doesn't match)
  paymentId         String?             @map("payment_id") @db.Uuid
  payment           Payment?            @relation(fields: [paymentId], references: [id])
  // Processing lifecycle
  processingStatus  WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  // Raw event data stored for debugging (sanitized - no secrets)
  rawPayload        Json?               @map("raw_payload")
  // Timestamps
  receivedAt        DateTime            @default(now()) @map("received_at")
  processedAt       DateTime?           @map("processed_at")
  // Sanitized error message if processing failed
  processingError   String?             @map("processing_error")

  @@index([cashfreeOrderId])
  @@index([processingStatus])
  @@index([receivedAt])
  @@map("webhook_events")
}

// ============================================================================
// Enums
// ============================================================================

/// Payment lifecycle status
enum PaymentStatus {
  CREATED   // Initial state - payment record created
  PENDING   // Cashfree order created, awaiting customer action
  PAID      // Payment verified as successful
  FAILED    // Payment failed (may allow retry)
  CANCELLED // Payment cancelled by user or system
  EXPIRED   // Payment link/order expired without completion
}

/// Individual payment attempt status
enum PaymentAttemptStatus {
  PENDING       // Attempt initiated, awaiting result
  SUCCESS       // Attempt succeeded
  FAILED        // Attempt failed
  USER_DROPPED  // User abandoned the payment flow
}

/// Webhook event processing status
enum WebhookProcessingStatus {
  RECEIVED    // Event received and recorded
  PROCESSING  // Event is being processed
  PROCESSED   // Event processed successfully
  FAILED      // Event processing failed (may be retried)
  SKIPPED     // Event skipped (e.g., duplicate, stale)
}
